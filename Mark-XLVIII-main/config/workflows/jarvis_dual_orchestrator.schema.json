{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow_id", "version", "name", "steps"],
  "properties": {
    "schema_version": {"const": "jarvis_dual_orchestrator/v1"},
    "workflow_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "version": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "preview_only": {"type": "boolean"},
    "max_steps": {"type": "integer", "minimum": 1, "maximum": 50},
    "variables": {"type": "object"},
    "governance_contracts": {"type": "array", "items": {"type": "string"}},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "orchestrator", "step_type", "target", "description", "risk_tier", "side_effects"],
        "properties": {
          "step_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "orchestrator": {"enum": ["cognitive", "deterministic"]},
          "step_type": {"enum": ["tool", "python_hook", "command", "model_reasoning", "gate", "fanout", "review", "artifact", "memory_commit"]},
          "target": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "depends_on": {"type": "array", "items": {"type": "string"}},
          "inputs": {"type": "object"},
          "outputs": {"type": "object"},
          "required_outputs": {"type": "array", "items": {"type": "string"}},
          "negative_constraints": {"type": "array", "items": {"type": "string"}},
          "risk_tier": {"enum": ["T1", "T2", "T3", "T4", "T5"]},
          "side_effects": {"enum": ["none", "local_read", "local_write", "external_read", "external_write", "destructive"]},
          "requires_confirmation": {"type": "boolean"},
          "retry_policy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "safe": {"type": "boolean"},
              "max_attempts": {"type": "integer", "minimum": 1, "maximum": 3}
            }
          },
          "compensation": {"type": "string"},
          "acceptance_criteria": {"type": "object"},
          "on_failure": {"enum": ["halt", "repair", "replan", "escalate", "continue"]}
        }
      }
    }
  }
}
