    {
      "id": "evidence_resource_library",
      "type": "text",
      "text": "role: evidence\nproject: resource_library\n\nRead the Resource Library vault read-only (project_operator learn_project) so the source-identification step has genuine, file-grounded evidence of what is actually catalogued instead of a guess.",
      "x": 500,
      "y": 640,
      "width": 420,
      "height": 180,
      "deliverables": [
        "Real, file-grounded takeaways about what the Resource Library actually catalogues, sourced from project_operator learn_project"
      ],
      "jarvis": {
