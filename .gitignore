# Root .gitignore for the Mark-XLVIII-main / Jarvis_notes monorepo.
# Created 2026-07-25 alongside the graphify integration -- see
# Jarvis_notes/workflows/contracts-compartmentalization-and-synergy/Plan.md
# for the audit that found this repo previously had no root-level .gitignore
# at all. Subdirectory projects (Agent_backend/, ToolSet/) keep their own,
# more specific .gitignore files; this one covers the shared/root concerns.

# -----------------------------
# graphify knowledge graph output
# -----------------------------
# Regenerated by .git/hooks/post-commit on every commit (graphify update),
# and by `graphify extract` manually. Large (graph.json/graph.html run several
# MB each) and fully reproducible from source -- committing it would create a
# multi-MB diff on every single future commit for no benefit.
graphify-out/
**/graphify-out/

# -----------------------------
# Vault backups (ad-hoc safety nets, not durable history)
# -----------------------------
# e.g. Jarvis_notes_backup_2026-07-25_pre_lifecycle_migration/ -- a
# point-in-time copy taken before a risky bulk vault operation. git history
# is the durable record; these are meant to be deleted once confidence is
# established, not committed.
Jarvis_notes_backup_*/

# -----------------------------
# Python
# -----------------------------
__pycache__/
*.py[cod]
*.pyo
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
env/
ENV/

# -----------------------------
# Nested independent git repos (not submodules)
# -----------------------------
# These are separate projects that happen to live under this tree, each with
# its own .git/. They are not registered as git submodules, so letting `git
# add` walk into them would embed foreign repo state incorrectly. Manage them
# in their own repos.
/Agent_backend/
/ToolSet/
Mark-XLVIII-main/tools/Orpheus-FastAPI-LMStudio/
Mark-XLVIII-main/runtime_validation/openclaw-worker/

# -----------------------------
# Claude Code local settings / runtime artifacts
# -----------------------------
# settings.local.json holds personal permission overrides (can include
# machine-specific host/path details); settings.json (shared, safe) stays
# tracked. scheduled_tasks.lock is a per-process runtime lock file.
/.claude/settings.local.json
/.claude/scheduled_tasks.lock

# Root-level Jarvis runtime log (distinct from the tracked Jarvis_notes/.jarvis/
# vault index) -- regenerated by .git/hooks/post-commit on every commit.
/.jarvis/*.log

# -----------------------------
# Editor / OS
# -----------------------------
.vscode/*
!.vscode/settings.example.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
